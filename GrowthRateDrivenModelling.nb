Cell["\<\
We now symbolically calculate and simplify the expression for the Case 2 \
integral using
\[CapitalDelta]FM(\|01d451) = FM(1, \|01d451) \[Minus] FM(0, \|01d451).\
\>", "Text",
 CellChangeTimes->{{3.955207145423276*^9, 3.95520719571478*^9}, {
   3.955207791178473*^9, 3.955207822898003*^9}, {3.955211272148452*^9, 
   3.95521130768232*^9}, 
   3.955211607292685*^9},ExpressionUUID->"7b112ec3-8d28-43f0-b2ac-\
0bc773954751"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"C2", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["1", "\[Tau]"], 
     RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"\[Lambda]1", "[", 
          RowBox[{"\[Omega]", " ", "t"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "ton"}], "}"}]}], "]"}], "+", 
       "\[IndentingNewLine]", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"\[Lambda]0", "[", 
          RowBox[{
           RowBox[{"\[Omega]", " ", "ton"}], " ", "-", " ", 
           RowBox[{"\[Omega]", " ", 
            RowBox[{"(", 
             RowBox[{"t", " ", "-", " ", "ton"}], ")"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "ton", ",", 
           RowBox[{"2", "ton"}]}], "}"}]}], "]"}], "+", "\[IndentingNewLine]", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"\[Lambda]0", "[", "0", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", 
           RowBox[{"2", "ton"}], ",", 
           RowBox[{"ton", "+", "toff"}]}], "}"}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FM10", "-", "FM00"}], "->", "\[CapitalDelta]FM0"}], "}"}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "FM0D"}], "+", "FM1D"}], "->", "\[CapitalDelta]FM1"}], 
    "}"}], "  "}]}]], "Input",
 CellChangeTimes->{{3.955211129677696*^9, 3.95521115101254*^9}, {
   3.955211184790041*^9, 3.955211218168111*^9}, 3.955211619955529*^9, {
   3.9552116533943863`*^9, 3.955211874147231*^9}, {3.9552119595239*^9, 
   3.955212140829259*^9}, {3.955212235850562*^9, 3.9552122550226927`*^9}, {
   3.955212291163156*^9, 3.9552123829014797`*^9}, {3.95521250829517*^9, 
   3.95521253152866*^9}, {3.955212590467743*^9, 3.9552126097319107`*^9}, 
   3.9552602222838373`*^9, {3.955260422394133*^9, 3.955260425255569*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"6b138a04-d7f0-4d1a-ac20-ea0b66c6d580"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"FM00", " ", "toff"}], "+", 
   RowBox[{"FM0D", " ", "ton"}], "+", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    SuperscriptBox["ton", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"\[CapitalDelta]FM0", "+", "\[CapitalDelta]FM1"}], ")"}], " ", 
    "\[Omega]"}]}], "\[Tau]"]], "Output",
 CellChangeTimes->{{3.9552111313071747`*^9, 3.95521115169135*^9}, {
   3.955211196302636*^9, 3.9552112190871887`*^9}, 3.955211621781836*^9, {
   3.955211656519187*^9, 3.955211686497671*^9}, {3.955211734452484*^9, 
   3.955211747424611*^9}, {3.9552117912692327`*^9, 3.955211820533145*^9}, {
   3.9552118509616737`*^9, 3.955211875297084*^9}, {3.955211962481826*^9, 
   3.9552120457056427`*^9}, 3.955212260842484*^9, {3.955212293716311*^9, 
   3.955212386704377*^9}, {3.955212497650086*^9, 3.955212508927485*^9}, {
   3.95521256350145*^9, 3.955212613504579*^9}, 3.9552602234149933`*^9, {
   3.955260416687603*^9, 3.955260425800743*^9}, 3.955274639011849*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"b2a4a865-1593-421f-b72e-1a05c20d3eac"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Case 3: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "off"], "<", 
    SubscriptBox["t", "on"], "<", 
    FractionBox["1", "\[Omega]"]}], TraditionalForm]],ExpressionUUID->
  "300b4ebc-c969-4078-a3d3-d89fd5fd5138"],
 " ."
}], "Subsubsection",
 CellChangeTimes->{{3.955206100985606*^9, 3.955206161441681*^9}, {
  3.955206317619706*^9, 3.955206320916847*^9}, {3.955207010527748*^9, 
  3.95520701281231*^9}, {3.955211367012105*^9, 3.9552113793320923`*^9}, {
  3.955212634341159*^9, 
  3.955212641364048*^9}},ExpressionUUID->"d11f5b7b-ec59-4645-b900-\
a581781886d3"],

Cell[TextData[{
 StyleBox["Drug off: ",
  FontWeight->"Bold"],
 "Phenotypes start at x=1, and then reach x=\[Omega]t during descending \
period of length ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "off"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "763280fa-effb-4fe8-aac1-25096ef6a6e3"],
 ". ",
 StyleBox["\nDrug on:",
  FontWeight->"Bold"],
 " Phenotypes reach x=1 during climbing period of length ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "off"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f19ec74a-8363-4efc-b2bb-0e14683242b7"],
 ", and then stay at x=1 until time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "on"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4d771275-abf3-4cc9-8fee-5de6469b915a"],
 "+ ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "off"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2dd1d80c-9750-4fb3-9d76-581736789caa"],
 ".\nA plot is shown below for (arbitrarily selected) values of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "on"], ",", 
    SubscriptBox["t", "off"], ",", " ", "\[Omega]"}], TraditionalForm]],
  ExpressionUUID->"382c8956-022c-4b12-b5af-b53e2799b353"],
 " such that Case 2 holds."
}], "Text",
 CellChangeTimes->{{3.955206337452941*^9, 3.955206573505227*^9}, {
   3.955206653318326*^9, 3.955206845973208*^9}, {3.9552094767750673`*^9, 
   3.9552095512794523`*^9}, {3.9552114016682177`*^9, 3.955211413114777*^9}, {
   3.955211480094696*^9, 3.9552115044137897`*^9}, {3.9552126471810007`*^9, 
   3.955212772451865*^9}, {3.955212816738378*^9, 3.95521283057936*^9}, 
   3.955260233674519*^9},ExpressionUUID->"f8fc09a0-159f-4414-ac64-\
c7a30867e11a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "[", "t_", "]"}], ":=", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "-", 
        RowBox[{"\[Omega]", " ", "t"}]}], " ", ",", 
       RowBox[{"t", "<", "toff"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "-", 
        RowBox[{"\[Omega]", " ", "toff"}], " ", "+", " ", 
        RowBox[{"\[Omega]", " ", 
         RowBox[{"(", 
          RowBox[{"t", "-", "toff"}], ")"}]}]}], ",", 
       RowBox[{"toff", "<=", "t", "<", 
        RowBox[{"2", " ", "toff"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{
        RowBox[{"2", " ", "toff"}], "<=", "t", "<=", 
        RowBox[{"ton", "+", "toff"}]}]}], "}"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Omega]", "->", "0.1"}], ",", 
      RowBox[{"ton", "->", "10"}], ",", 
      RowBox[{"toff", "->", "3"}]}], "}"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "15"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.948492671204945*^9, 3.948492731274646*^9}, {
   3.9484927761187277`*^9, 3.948492795295293*^9}, {3.948493034987195*^9, 
   3.948493065416823*^9}, {3.955212989177618*^9, 3.955213076741548*^9}, {
   3.955258395888842*^9, 3.955258402320652*^9}, 3.955260258573647*^9},
 CellLabel->"In[12]:=",ExpressionUUID->"82e6ec82-1b47-498f-948d-4f94706cf913"],

