Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "[", "t_", "]"}], ":=", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Omega]", " ", "t"}], ",", 
       RowBox[{"t", "<", "ton"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Omega]", " ", "ton"}], " ", "-", " ", 
        RowBox[{"\[Omega]", " ", 
         RowBox[{"(", 
          RowBox[{"t", " ", "-", " ", "ton"}], ")"}]}]}], ",", 
       RowBox[{"ton", "<=", "t", "<", 
        RowBox[{"2", "ton"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"2", " ", "ton"}], "<=", "t", "<=", 
        RowBox[{"ton", "+", "toff"}]}]}], "}"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Omega]", "->", "0.1"}], ",", 
      RowBox[{"ton", "->", "3"}], ",", 
      RowBox[{"toff", "->", "10"}]}], "}"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "15"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.955207087522655*^9, 3.955207087755336*^9}, {
