Cell["\<\
We now symbolically calculate and simplify the expression for the Case 1 \
integral using
\[CapitalDelta]FM(\|01d451) = FM(1, \|01d451) \[Minus] FM(0, \|01d451). \
\>", "Text",
 CellChangeTimes->{{3.955207145423276*^9, 3.95520719571478*^9}, {
  3.955207791178473*^9, 3.955207822898003*^9}, {3.955211272148452*^9, 
  3.95521130768232*^9}, {3.9552601517056093`*^9, 3.955260158206197*^9}, {
  3.955263157554044*^9, 3.9552632630042458`*^9}, {3.95526481488984*^9, 
  3.955264823756035*^9}},ExpressionUUID->"f3e11f7f-eb9a-4784-a8d8-\
a1837c332da5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"C1", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["1", "\[Tau]"], 
     RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"\[Lambda]1", "[", 
          RowBox[{"\[Omega]", " ", "t"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", 
           FractionBox["1", "\[Omega]"]}], "}"}]}], "]"}], "+", 
       "\[IndentingNewLine]", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"\[Lambda]1", "[", "1", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", 
           FractionBox["1", "\[Omega]"], ",", "ton"}], "}"}]}], "]"}], "+", 
       "\[IndentingNewLine]", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"\[Lambda]0", "[", 
          RowBox[{"1", "-", 
           RowBox[{"\[Omega]", " ", 
            RowBox[{"(", 
             RowBox[{"t", "-", "ton"}], ")"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "ton", ",", 
           RowBox[{"ton", "+", 
            FractionBox["1", "\[Omega]"]}]}], "}"}]}], "]"}], "+", 
       "\[IndentingNewLine]", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"\[Lambda]0", "[", "0", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", 
           RowBox[{"ton", "+", 
            FractionBox["1", "\[Omega]"]}], ",", 
           RowBox[{"ton", "+", "toff"}]}], "}"}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FM10", "-", "FM00"}], "->", " ", "\[CapitalDelta]FM0"}], 
     "}"}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FM0D", "-", "FM1D"}], "->", " ", 
     RowBox[{"-", "\[CapitalDelta]FMD"}]}], "}"}], " "}]}]], "Input",
 CellChangeTimes->{{3.955211129677696*^9, 3.95521115101254*^9}, {
  3.955211184790041*^9, 3.955211218168111*^9}, {3.955212149383932*^9, 
  3.955212159458078*^9}, {3.955260400936557*^9, 3.955260404065464*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"bc38a8c4-3f42-4fdd-8b79-2fb9bc6ac332"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"FM00", " ", "toff"}], "+", 
   RowBox[{"FM1D", " ", "ton"}], "+", 
   FractionBox[
    RowBox[{"\[CapitalDelta]FM0", "-", "\[CapitalDelta]FMD"}], 
    RowBox[{"2", " ", "\[Omega]"}]]}], "\[Tau]"]], "Output",
 CellChangeTimes->{{3.9552111313071747`*^9, 3.95521115169135*^9}, {
   3.955211196302636*^9, 3.9552112190871887`*^9}, {3.955212152078229*^9, 
   3.95521216071049*^9}, 3.955260404794835*^9, 3.955274638680125*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"70d4ecf1-5e6c-49aa-b1fa-f9ba9045a965"]
}, Open  ]],

Cell[TextData[{
 "Now customised, numerical values for  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "on"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ca095033-d8c0-4c7d-bc95-947322daecd8"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "off"], ","}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1afa451e-de59-45c8-a556-3c0789b81f8a"],
 " \[Omega], can be inserted into the expression for C1 to obtain ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\|01d706", "eff"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8d0b1bce-08db-4333-babe-474f62f2e891"],
 " ."
}], "Text",
 CellChangeTimes->{{3.955264937185576*^9, 
  3.955265103248146*^9}},ExpressionUUID->"8083dc91-f7f8-45fb-8d14-\
8a52f5e7f50e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"C1num", "=", 
    RowBox[{"C1", "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalDelta]FM0", "->", 
        RowBox[{"FM10", "-", "FM00"}]}], ",", 
       RowBox[{"\[CapitalDelta]FMD", "->", 
        RowBox[{"FM1D", "-", "FM0D"}]}], ",", " ", 
       RowBox[{"\[Tau]", "->", 
        RowBox[{"ton", "+", "toff"}]}]}], "}"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Writing", " ", "C1", " ", "in", " ", "long", " ", "format"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"C1num", "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"FM0D", "->", 
     RowBox[{"-", "0.2866"}]}], ",", 
    RowBox[{"FM1D", "->", "0.0741"}], ",", 
    RowBox[{"FM00", "->", "0.1374"}], ",", 
    RowBox[{"FM10", "->", "0.07067"}], ",", "\[IndentingNewLine]", 
    RowBox[{"\[Omega]", "->", "0.5"}], ",", 
    RowBox[{"ton", " ", "->", "5"}], ",", 
    RowBox[{"toff", "->", "10"}]}], "}"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "As", " ", "used", " ", "in", " ", "the", " ", "above", " ", "plot"}], 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.95526434501049*^9, 3.955264654758484*^9}, {
  3.955264744633759*^9, 3.9552647887068357`*^9}, {3.955264877721918*^9, 
  3.9552649057263107`*^9}, {3.9552651080743628`*^9, 3.955265140010388*^9}, {
  3.9552651813399487`*^9, 3.95526523817561*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"c2133bd2-10c1-4920-8d90-11788846dbcb"],

Cell[BoxData["0.08780466666666667`"], "Output",
 CellChangeTimes->{3.955265501275921*^9, 3.955274638761787*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"92af1e69-ee9c-440b-8cf1-0d61aef52352"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Case 2: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "on"], "<", 
    SubscriptBox["t", "off"], "<", 
    FractionBox["1", "\[Omega]"]}], TraditionalForm]],ExpressionUUID->
  "c702aa72-43fc-4f82-89d7-e6e345ef968b"],
 " ."
}], "Subsubsection",
 CellChangeTimes->{{3.955206100985606*^9, 3.955206161441681*^9}, {
  3.955206317619706*^9, 3.955206320916847*^9}, {3.955207010527748*^9, 
  3.95520701281231*^9}, {3.955211367012105*^9, 
  3.9552113793320923`*^9}},ExpressionUUID->"f5f71a63-4b3b-4bec-94e0-\
2b5220b1ded0"],

Cell[TextData[{
 StyleBox["Drug on:",
  FontWeight->"Bold"],
 " Phenotypes start at x=0, and then reach x=\[Omega]t during climbing period \
of length ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "on"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2a723e9c-c387-4ce8-a752-6c57651c372d"],
 ". \n",
 StyleBox["Drug off: ",
  FontWeight->"Bold"],
 "Cells reach x=0 during a descending period of length ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "on"], TraditionalForm]],ExpressionUUID->
  "1bf2d668-5850-4b06-bda1-99b4298864e3"],
 ", and then stay at x=0 until time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "on"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f252a476-b943-444f-86b0-82d02f0b0959"],
 "+ ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "off"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "560936a4-0a0f-4576-9795-12af1cf6d1b7"],
 ". \nA plot is shown below for (arbitrarily selected) values of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "on"], ",", 
    SubscriptBox["t", "off"], ",", " ", "\[Omega]"}], TraditionalForm]],
  ExpressionUUID->"560cbf22-e5a3-49a4-ae4a-6ab7496bc082"],
 " such that Case 2 holds."
}], "Text",
