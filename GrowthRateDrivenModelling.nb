9ed2a967c894"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"C4", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "*", "ton"}]], 
     RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"\[Lambda]1", "[", 
          RowBox[{"\[Omega]", " ", "t"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "ton"}], "}"}]}], "]"}], "+", 
       "\[IndentingNewLine]", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"\[Lambda]0", "[", 
          RowBox[{"1", "-", 
           RowBox[{"\[Omega]", " ", 
            RowBox[{"(", 
             RowBox[{"t", "-", 
              RowBox[{"(", "ton", ")"}]}], ")"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "ton", ",", 
           RowBox[{"2", "*", "ton"}]}], "}"}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ton", "*", "\[Omega]"}], " ", "->", " ", "1"}], "}"}]}], " ", "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "FM0D"}], "-", "FM10", "+", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"FM0D", "+", "FM10"}], ")"}]}]}], "->", 
     RowBox[{"FM0D", "+", "FM10"}]}], " ", "}"}]}]}]], "Input",
 CellChangeTimes->{{3.955261432511945*^9, 3.9552614931001787`*^9}, 
   3.955261622367992*^9, {3.955262221180501*^9, 3.9552622816344957`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"4772c01d-732f-49ce-9549-8172bfcf2671"],

