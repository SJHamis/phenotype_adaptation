Cell[TextData[{
 StyleBox["Drug on:",
  FontWeight->"Bold"],
 " Phenotypes start at x=0, and then reach x=1 during climbing period of \
length",
 Cell[BoxData[
  RowBox[{" ", 
   FractionBox["T", "2"]}]],ExpressionUUID->
  "b683dc8a-2647-45f5-b7b4-0bbda66ffa18"],
 ". \n",
 StyleBox["Drug off: ",
  FontWeight->"Bold"],
 "Cells reach x=0 during a descending period of length",
 Cell[BoxData[
  RowBox[{" ", 
   FractionBox["T", "2"]}]],ExpressionUUID->
  "403e50ea-fd78-44f6-9a24-d486d19f148e"],
 ". \nA plot is shown below for (arbitrarily selected) values of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "on"], "=", 
    SubscriptBox["t", "off"]}], TraditionalForm]],ExpressionUUID->
  "81b3289c-6f57-451d-8d1c-29a956ae9b65"],
 " such that Case 2 holds."
}], "Text",
