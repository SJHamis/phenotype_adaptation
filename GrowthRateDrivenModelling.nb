Notebook[{

Cell[CellGroupData[{
Cell["Growth-rate driven modelling study", "Section",
 CellChangeTimes->{{3.955204424895685*^9, 3.9552044697216578`*^9}, {
  3.9552056669785137`*^9, 
  3.955205667752894*^9}},ExpressionUUID->"b0b62485-3aa2-4d62-9889-\
3f45b88d7a8a"],

Cell[CellGroupData[{

Cell[TextData[{
 "Supplementary material to ",
 StyleBox["Hamis, Browning, Jenner, Villa, Maini, Cassidy (2025).",
  FontSlant->"Italic"]
}], "Subsubsection",
 CellChangeTimes->{{3.9552595236029873`*^9, 
  3.9552595741084213`*^9}},ExpressionUUID->"a7849c4b-d1f2-499e-8573-\
109daf662e04"],

Cell[TextData[{
 "In this Notebook we calculate\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\|01d706", "eff"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9fb797a6-905f-494e-a1a3-91661011c0bc"],
 " = ",
 Cell[BoxData[
  FractionBox["1", "\[Tau]"]],
  CellChangeTimes->{{3.94849251350916*^9, 3.948492540205078*^9}, {
   3.9484925882581787`*^9, 3.9484925902482843`*^9}, {3.948497537733885*^9, 
   3.948497578832838*^9}},ExpressionUUID->
  "6a8cd62b-c082-4470-bc72-731ace9a7e8d"],
 " (",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", 
    SubscriptBox["t", "on"]], 
   RowBox[{"FM", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"x", 
       RowBox[{"(", "t", ")"}]}], ",", "d"}], ")"}]}]}]],
  CellChangeTimes->{3.955205391472311*^9},ExpressionUUID->
  "6a8eb54b-3c36-4222-81fe-a5f2daa233cc"],
 "\[DifferentialD]t + ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["\[Integral]", 
    SubscriptBox["t", "on"], 
    SubscriptBox["t", "off"]], 
   RowBox[{"FM", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"x", 
       RowBox[{"(", "t", ")"}]}], ",", "0"}], ")"}]}]}]],
  CellChangeTimes->{3.955205391472311*^9},ExpressionUUID->
  "690d6d08-de4c-49a8-8803-610c547ec743"],
 "\[DifferentialD]t )\[LineSeparator]for different choices of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\|01d461", "on"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e13d7648-4db4-43eb-8ce4-e35923aa0774"],
 " (the duration that the drug is ",
 StyleBox["on",
  FontSlant->"Italic"],
 ") and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\|01d461", "off"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c91c9691-11fe-46a2-bc8d-0c1caf91608e"],
 " (the duration that the drug is ",
 StyleBox["off",
  FontSlant->"Italic"],
 "). "
}], "Text",
 CellChangeTimes->{{3.95520447734363*^9, 3.955204515006709*^9}, {
  3.955204610984877*^9, 3.9552047752098837`*^9}, {3.9552048780346947`*^9, 
  3.955205000037863*^9}, {3.9552050438903093`*^9, 3.9552051073215733`*^9}, {
  3.955205182546904*^9, 3.955205248887576*^9}, {3.955205373086376*^9, 
  3.955205451835702*^9}, {3.955205499790475*^9, 3.955205530538595*^9}, {
  3.955205563265666*^9, 3.955205619228468*^9}, {3.9552063769839363`*^9, 
  3.955206391041698*^9}, {3.955209298671886*^9, 3.9552092996123047`*^9}, {
  3.9552594424457808`*^9, 
  3.955259513349997*^9}},ExpressionUUID->"857878fa-5e35-41cc-812e-\
5a1af29b7f7b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Define growth rates as functions of the phenotype state x:", \
"Subsubsection",
 CellChangeTimes->{{3.9552059303355513`*^9, 3.955205966564169*^9}, 
   3.955206112300021*^9, 3.955206151876473*^9, {3.955259817904482*^9, 
   3.955259820599742*^9}},ExpressionUUID->"e2403607-2e8a-4229-8367-\
5157a463b285"],

Cell["\<\
In the notebook, FMxd denotes FM(x,d) where 
x=0 is the least drug-adapted phenotype state, 
x=1 is the most drug adapted phenotype state,
d=0 means \[OpenCurlyDoubleQuote]drug is off\[CloseCurlyDoubleQuote], 
d=D means \[OpenCurlyDoubleQuote]drug is on\[CloseCurlyDoubleQuote] at a \
selected dose D.\
\>", "Text",
 CellChangeTimes->{{3.955209336248254*^9, 3.955209368617132*^9}, {
  3.955259382127995*^9, 3.955259437141913*^9}, {3.955259605014942*^9, 
  3.955259658206922*^9}, {3.955259705146249*^9, 
  3.955259782030809*^9}},ExpressionUUID->"35bc3bc1-8c0c-42f0-8516-\
7491fdf009eb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]0", "[", "x_", "]"}], ":=", 
   RowBox[{"FM00", "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"FM10", "-", "FM00"}], ")"}], "x"}]}]}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"no", " ", "drug"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]1", "[", "x_", "]"}], ":=", 
  RowBox[{"FM0D", "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"FM1D", "-", "FM0D"}], ")"}], "x", " ", 
    RowBox[{"(*", " ", "drug", " ", "*)"}]}]}]}]}], "Input",
 CellChangeTimes->{{3.955209054011527*^9, 3.9552091326972237`*^9}, {
  3.955209277849504*^9, 3.955209283969369*^9}, {3.955209385493043*^9, 
  3.95520940217388*^9}, {3.9552100885411777`*^9, 3.955210091811904*^9}, {
  3.95521085690802*^9, 3.9552108575007687`*^9}, {3.955259674421006*^9, 
  3.955259678474062*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"3bef483b-912c-408d-91f6-d5ce34be658c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["State assumptions:", "Subsubsection",
 CellChangeTimes->{{3.955206100985606*^9, 3.955206161441681*^9}, 
   3.955211249586454*^9, {3.9552598310351763`*^9, 
   3.9552598317570133`*^9}},ExpressionUUID->"d3396c9f-03bd-4e79-ba9a-\
8b0fa4465ad0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"\[Omega]", ">", "0"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.955206272061734*^9, 3.9552062813854322`*^9}, 
   3.9552068623152857`*^9, {3.9552072388467703`*^9, 3.955207347165759*^9}, {
   3.9552077151623983`*^9, 3.955207758260147*^9}, {3.95520797862996*^9, 
   3.9552079972027903`*^9}, 3.955208211287339*^9, {3.955208280217167*^9, 
   3.955208283758971*^9}, {3.955209139163458*^9, 3.955209153368908*^9}, {
   3.955209410752809*^9, 3.955209413492535*^9}, {3.9552099886462297`*^9, 
   3.95521002750706*^9}, {3.955210093305917*^9, 3.9552100955063143`*^9}, {
   3.955210291383854*^9, 3.955210300528503*^9}, {3.95521062258654*^9, 
   3.955210688131145*^9}, 3.9552107235969553`*^9, 3.95521109466897*^9, {
   3.955211252060788*^9, 3.955211253366694*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"18109229-7787-41b8-acbe-b8e076d53167"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Case 1: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "on"], ",", 
    RowBox[{
     SubscriptBox["t", "off"], ">", 
     FractionBox["1", "\[Omega]"]}]}], TraditionalForm]],ExpressionUUID->
  "b530a31e-380f-4bab-89d8-e45baead3ecf"],
 " ."
}], "Subsubsection",
 CellChangeTimes->{{3.955206100985606*^9, 3.955206161441681*^9}, {
  3.955206317619706*^9, 3.955206320916847*^9}, {3.955207010527748*^9, 
  3.95520701281231*^9}},ExpressionUUID->"244a2491-793b-4167-a039-\
d6e5ae5b6e91"],

Cell[TextData[{
 StyleBox["Drug on:",
  FontWeight->"Bold"],
 " Phenotypes start at x=0, reach x=1 during climbing period of length 1/\
\[Omega],  and then stay at x=1 until time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "on"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40b7a5a6-0a74-4315-ad67-1ca9f2caa201"],
 ". \n",
 StyleBox["Drug off: ",
  FontWeight->"Bold"],
 "Cells reach x=0 during a descending period of length 1/\[Omega], and then \
stay at x=0 until time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "on"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "07c0bd23-bb66-413e-8c5a-21efa16883fc"],
 "+ ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "off"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e05e5073-9354-43db-bbf4-2cc157717928"],
 ". \nA plot is shown below for (arbitrarily selected) values of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "on"], ",", 
    SubscriptBox["t", "off"], ",", " ", "\[Omega]"}], TraditionalForm]],
  ExpressionUUID->"ec5284b0-f837-4277-ac21-7b9c8ef5bcae"],
 " such that Case 1 holds."
}], "Text",
 CellChangeTimes->{{3.955206337452941*^9, 3.955206573505227*^9}, {
  3.955206653318326*^9, 3.955206845973208*^9}, {3.9552094767750673`*^9, 
  3.9552095512794523`*^9}, {3.955212779277931*^9, 3.955212785586627*^9}, {
  3.955259870673978*^9, 
  3.955259896919869*^9}},ExpressionUUID->"f42469ae-4193-4e7c-b9f8-\
e00731dfea31"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", "t_", "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Omega]", " ", "t"}], ",", 
        RowBox[{"t", "<", 
         FractionBox["1", "\[Omega]"]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{
         FractionBox["1", "\[Omega]"], "<=", "t", "<=", "ton"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "-", 
         RowBox[{"\[Omega]", " ", 
          RowBox[{"(", 
           RowBox[{"t", "-", "ton"}], ")"}]}]}], ",", 
        RowBox[{"ton", "<", "t", "<", 
         RowBox[{"ton", "+", 
          FractionBox["1", "\[Omega]"]}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"t", ">=", 
         RowBox[{"ton", "+", 
          FractionBox["1", "\[Omega]"]}]}]}], "}"}]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Omega]", "->", "0.5"}], ",", 
      RowBox[{"ton", "->", "5"}], ",", 
      RowBox[{"toff", "->", "10"}]}], "}"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "15"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<x(t)\>\""}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.955207087522655*^9, 3.955207087755336*^9}, {
  3.955209630515828*^9, 3.955209632004298*^9}, {3.955209696213524*^9, 
  3.95520969721725*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"bdd12108-4b19-4b48-9b56-3ae98848bb25"],

