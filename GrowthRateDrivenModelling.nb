Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"C3", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["1", "T"], 
     RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"\[Lambda]0", "[", 
          RowBox[{"1", "-", 
           RowBox[{"\[Omega]", " ", "t"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "toff"}], "}"}]}], "]"}], "+", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"\[Lambda]1", "[", 
          RowBox[{"1", "-", 
           RowBox[{"\[Omega]", " ", "toff"}], " ", "+", " ", 
           RowBox[{"\[Omega]", " ", 
            RowBox[{"(", 
             RowBox[{"t", "-", "toff"}], ")"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "toff", ",", 
           RowBox[{"2", " ", "toff"}]}], "}"}]}], "]"}], "+", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"\[Lambda]1", "[", "1", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", 
           RowBox[{"2", " ", "toff"}], ",", 
           RowBox[{"ton", "+", "toff"}]}], "}"}]}], "]"}]}], " ", 
      "\[IndentingNewLine]", "]"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FM0D", "-", "FM1D"}], "->", 
      RowBox[{"-", "\[CapitalDelta]FMD"}]}], "}"}]}], "  ", "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FM00", "-", "FM10"}], "->", 
     RowBox[{"-", "\[CapitalDelta]FM0"}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.95521306745804*^9, 3.955213070833077*^9}, {
  3.955213195431211*^9, 3.95521327450467*^9}, {3.9552134430038633`*^9, 
